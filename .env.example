# ── Application secrets ───────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# Postgres
POSTGRES_USER=northwind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=northwind

# SQLAlchemy (used by backend service directly)
DATABASE_URL=postgresql://northwind:changeme@localhost:5432/northwind

# Auth
JWT_SECRET=change-me-to-a-random-256-bit-string

# Google Gemini API
GOOGLE_API_KEY=AIzaSy...

# LLM
LLM_MODEL=gemini-flash-latest

# RAG guardrail (cosine similarity threshold, 0–1)
CONFIDENCE_THRESHOLD=0.69

# CORS – comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
